assert(not bool(nil))
assert(not bool(false))
assert(not bool(0))
assert(not bool(0.0))
assert(not bool(-0.0))
assert(not bool(""))
assert(bool(true))
assert(bool(42))
assert(bool(-1))
assert(bool(0.5))
assert(bool("x"))
assert(bool(print))
assert(str(nil) == "nil")
assert(str(true) == "true")
assert(str(false) == "false")
assert(str(42) == "42")
assert(str(2.5) == "2.5")
assert(str(3.0) == "3.0")
assert(str("hello") == "hello")
print("convert ok")
