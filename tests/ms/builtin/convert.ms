assert(not bool(nil))
assert(not bool(false))
assert(not bool(0))
assert(not bool(0.0))
assert(not bool(-0.0))
assert(not bool(""))
assert(bool(true))
assert(bool(42))
assert(bool(-1))
assert(bool(0.5))
assert(bool("x"))
assert(bool(print))
assert(str(nil) == "nil")
assert(str(true) == "true")
assert(str(false) == "false")
assert(str(42) == "42")
assert(str(2.5) == "2.5")
assert(str(3.0) == "3.0")
assert(str("hello") == "hello")
assert(int(3.9) == 3)
assert(int(-3.9) == -3)
assert(int(true) == 1)
assert(int(false) == 0)
assert(int("42") == 42)
assert(int("-42") == -42)
assert(int("1F", 16) == 31)
assert(int("0x1F", 16) == 31)
assert(int("101", 2) == 5)
assert(int("17", 8) == 15)
assert(str(float(2)) == "2.0")
assert(str(float(true)) == "1.0")
assert(str(float("3.14")) == "3.14")
assert(not bool([]))
assert(not bool({}))
assert(bool([1]))
assert(bool({"a": 1}))
assert(str([1, "two"]) == "[1, \"two\"]")
assert(str({"a": 1}) == "{\"a\": 1}")
print("convert ok")
