assert(str(range(5)) == "[0, 1, 2, 3, 4]")
assert(str(range(2, 8)) == "[2, 3, 4, 5, 6, 7]")
assert(str(range(0, 10, 3)) == "[0, 3, 6, 9]")
assert(str(range(5, 0, -1)) == "[5, 4, 3, 2, 1]")
assert(str(range(3, 3)) == "[]")
assert(str(range(3, 1)) == "[]")
assert(len(range(0, 100, 7)) == 15)
print("range ok")
