first, second, third := range(3)
assert(first == 0)
assert(second == 1)
assert(third == 2)
head, *rest := range(5)
assert(rest == [1, 2, 3, 4])
left, *middle, right := range(5)
assert(left == 0)
assert(middle == [1, 2, 3])
assert(right == 4)
*leading, last := range(3)
assert(leading == [0, 1])
assert(last == 2)
*empty, only := range(1)
assert(empty == [])
assert(only == 0)
first, second = range(2)
assert(first == 0)
assert(second == 1)
begin, *items, end := 10, 11, 12, 13
assert(begin == 10)
assert(items == [11, 12])
assert(end == 13)
print(rest)
print("unpack ok")
